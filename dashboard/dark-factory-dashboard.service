[Unit]
Description=Dark Factory Dashboard (monitoring UI)
Documentation=file:///home/leo/src/dark-factory/dashboard/prd.md
After=network.target fused-memory.service

[Service]
Type=simple
WorkingDirectory=/home/leo/src/dark-factory
# Bounded shutdown drain. uvicorn hard-bounds the connection drain: it wraps
# _wait_tasks_to_complete() in asyncio.wait_for(timeout=8) (uvicorn/server.py) and then
# force-cancels whatever is still running, so the process reaches lifespan shutdown by
# ~T+8s -- comfortably inside TimeoutStopSec=15, leaving ~7s for lifespan shutdown,
# interpreter exit and the `uv run` parent's own teardown. Without this flag the drain
# was unbounded: a browser polling every 3s never let its keep-alive connections idle
# out, so the drain never completed and every restart ended in
# "State 'stop-sigterm' timed out. Killing." -> SIGKILL -> a ~16s dead window.
#
# --timeout-keep-alive 5 is uvicorn's own default, pinned deliberately rather than
# changed. It is kept ABOVE the client's 3s poll interval on purpose: dropping it below
# 3s would close the polling socket in the gap between polls, exposing the
# server-closes-while-client-writes race -- trading a shutdown bug for a request-failure
# bug. Keep-alive is not being asked to bound the drain; --timeout-graceful-shutdown
# already does that. Pinning it makes the poll-interval/keep-alive relationship explicit
# and greppable instead of hiding behind an implicit default.
ExecStart=/home/leo/.local/bin/uv run --project dashboard \
  python -m uvicorn dashboard.app:app \
  --host 127.0.0.1 --port 8080 \
  --timeout-graceful-shutdown 8 \
  --timeout-keep-alive 5

# Cost/burndown aggregation roots (comma-separated). Standalone default: this repo only — additional project roots are LOCAL settings, added to the installed unit, not committed here. Keep spaces out of the value; systemd treats unquoted spaces as assignment separators.
Environment=DASHBOARD_KNOWN_PROJECT_ROOTS=/home/leo/src/dark-factory

# Restart policy: always restart on failure, back off up to 60s.
# RestartSteps is load-bearing here, not decorative. Without it systemd logs
# "Service has RestartMaxDelaySec= but no RestartSteps= setting. Ignoring." at
# unit load and discards the cap entirely, so the backoff this comment claims
# never happens and a crash-looping dashboard retries every 5s forever.
# With it: backoff 5s -> 60s over 4 steps.
Restart=on-failure
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60

# A clean SIGTERM stop exits 143, not 0: `uv run` propagates its child's signal
# death as 128+15. Without this line systemd's default classification records
# every graceful stop as "Failed with result exit-code" (status=143) — observed
# 2026-07-30 22:23:53 BST on this unit after task 3306's bounded-drain change,
# with six keep-alive clients attached. Left alone it compounds: each routine
# restart plants a false failure until "failed" means nothing and a real crash
# reads exactly like a deploy.
#
# Numeric, not SIGTERM: `uv run` translates the signal into an exit code before
# systemd sees it, so the journal reports result=exit-code/status=143 and a
# signal-name entry would not match what systemd actually observes.
#
# The trade: with 143 classified as success, Restart=on-failure no longer
# re-fires on it. That is intended, and it does not weaken supervision — both
# programmatic restart paths (scripts/restart-dashboard.sh:21,
# scripts/dashboard-watchdog.py) issue `systemctl --user restart`, an explicit
# stop for which systemd never consults Restart= at all. The residual case is
# an out-of-band `kill -TERM`, which dark-factory-dashboard-watchdog.timer
# covers by probing /api/health every 30s and restarting a dead dashboard
# (arming the installed timer is task 3289's job, not this file's).
SuccessExitStatus=143

TimeoutStopSec=15

# Logging goes to journalctl --user -u dark-factory-dashboard
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
