[Unit]
Description=Dashboard availability watchdog (hysteresis probe, storm escape)

[Service]
Type=oneshot
# 2026-07-30 incident. This ExecStart used to be a one-line inline shell —
# /bin/sh -c running, in full:
#
#   curl -sf --max-time 5 http://127.0.0.1:8080/healthz \
#     || systemctl --user restart dark-factory-dashboard.service
#
# Two defects, compounding. It probed /healthz, the DEEP health endpoint —
# three 5s DB probes — so a dashboard that was merely SLOW read as dead; and it
# restarted on a SINGLE miss with no rate ceiling, so every restart made the
# next probe likelier to time out. Measured result: 192 restarts in 3 hours,
# ~27% downtime, from a service that was still serving requests throughout.
#
# The probe therefore moved to the SHALLOW endpoint (/api/health — a bare
# {'status': 'ok'} handler with no DB access), and the policy moved out of
# this file entirely. Supervision logic inside an `sh -c` string is a
# contract-in-prose (INV-1): no test can reach it, which is how a
# single-sample restarter shipped unnoticed. It now lives in a real script
# with a real test suite:
#
#   policy    scripts/dashboard-watchdog.py  (hysteresis, grace, rate ceiling)
#   tests     tests/scripts/test_dashboard_watchdog.py
#             dashboard/tests/test_dashboard_watchdog_storm_escape.py
#   contract  plans/dashboard-availability-prd.md §Contract  ← the real one
#
# Type=oneshot is load-bearing: every timer tick is a FRESH process, so the
# failure streak and the rolling restart window are persisted to disk by the
# script rather than held in memory.
ExecStart=/home/leo/src/dark-factory/scripts/dashboard-watchdog.py
# Belt-and-braces bound on the WHOLE tick. systemd disables TimeoutStartSec for
# Type=oneshot by default, and the timer's OnUnitActiveSec=30 measures from this
# unit's last activation — so a tick that never returns is not a slow tick, it is
# the END of supervision: the timer never re-triggers and nothing says so. The
# script bounds each of its own children (probe 5s, systemctl show 5s,
# reset-failed 10s, restart 45s, `escalation submit` 120s), whose worst-case
# path — probe + show + submit — is ~130s. 300 sits comfortably above that, so
# it can only ever fire on a genuine wedge (stuck journald, uninterruptible I/O),
# never on a legitimately slow escalation, and a wedge costs one tick instead of
# all of them.
TimeoutStartSec=300
# The script logs its decisions via systemd-cat -t dashboard-watchdog; these
# two route anything else it prints to the same journal, so
# `journalctl --user -t dashboard-watchdog` is the single place to read why
# the watchdog did — or deliberately did not — act.
StandardOutput=journal
StandardError=journal
