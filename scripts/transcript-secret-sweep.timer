[Unit]
Description=Nightly timer for the transcript secret sweep (task 6820)

[Timer]
# Nightly at 02:30 local time, the free slot ahead of this machine's staggered
# ladder (03:00 .. 06:00); see OPERATIONS.md §12 for the ladder as a whole.
# Persistent=true catches up a night missed to a sleeping laptop; the
# randomized delay avoids a thundering herd.
OnCalendar=*-*-* 02:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
