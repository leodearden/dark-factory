[Unit]
Description=jCodeMunch watch-claude (auto-index worktrees)
After=network.target

[Service]
Type=simple
# inotify-exhaustion fix (2026-06-11): watch-claude uses watchfiles.awatch
# (recursive=True, no filter — watcher.py:229), and inotify costs one watch PER
# DIRECTORY regardless of any event-level filter (the Rust notify crate registers
# watches before filtering). With dozens of full worktrees nested under the
# watched repos (~712k fs entries) one process held 523,811 / 524,288 of
# fs.inotify.max_user_watches, ENOSPC-failing every other inotify consumer on
# the host (L2 watcher, editors). The watcher passes force_polling unset, so
# watchfiles honors these env vars: FORCE_POLLING switches the backend to
# stat-polling — ZERO inotify watches (verified in the pinned env: 60-dir tree
# → 61 watches default, 0 with the env set).
# Poll delay 300s: at 30s the ~137 per-folder poller threads (one stat-walk of
# the whole tree each, ignore patterns NOT honored) averaged 337% CPU
# (measured over a full cycle, 2026-06-11). 5min change-detection latency is
# fine for indexing — the 2s debounce only batches events after detection.
Environment=WATCHFILES_FORCE_POLLING=true
Environment=WATCHFILES_POLL_DELAY_MS=300000
# Initial index peaked at 6.2G RSS (2026-06-11). Cap so a runaway can't starve
# the host: throttle at 8G, hard-kill at 12G (Restart=always recovers).
MemoryHigh=8G
MemoryMax=12G
# Background indexing should lose CPU contention against orchestrator/build work.
CPUWeight=30
# PyPI was quarantined 2026-05-30 (admin review #308) and restored 2026-06-11.
# Back on PyPI with an EXACT pin — supply-chain history means no floating
# versions: bump deliberately after verifying the sdist matches the upstream git
# tag (1.108.54 verified identical modulo CRLF, 2026-06-11) and INDEX_VERSION is
# unchanged (v16 — no forced re-index). The v2.x git tags are an OLDER/divergent
# line (index-schema v8) despite the higher semver — do NOT pin 2.x.
# --poll-interval 300 (default 5): discovery cadence for new/removed worktrees
# (also rate-limits the per-cycle `git worktree list` subprocesses).
#
# REPO SELECTION WARNING (2026-06-11): do NOT include a repo whose worktrees
# share one git_root identity en masse (e.g. reify's ~220-tree warm-build/eval
# swarm, all "leodearden/reify"). Every initial index fails with "Index already
# exists" — but _watch_single does NOT raise on that, it keeps watching anyway.
# Net effect: hundreds of permanently-unindexable trees get stat-polled forever
# and every build-churn change event triggers a doomed re-index attempt (was
# the bulk of 154% steady-state CPU). Coverage lost by excluding them is ~nil:
# identity-sharing worktrees could only clobber the shared index with random
# branch state (known upstream wart).
ExecStart=__UV_PATH__x --python 3.12 --from "jcodemunch-mcp[watch]==1.108.54" \
  jcodemunch-mcp watch-claude \
  --poll-interval 300 \
  --repos __REPO_ROOT__

# Restart policy: Restart=always, NOT on-failure. watch-claude is a daemon that
# should never stay down, but it exits 0 on more than just signals: its main loop
# is asyncio.wait(FIRST_COMPLETED) over the repos-poller/manifest-watcher tasks,
# so an exception that kills a management task is swallowed and the process
# shuts down "cleanly" (observed 2026-05-30: exit 0/SUCCESS after 1h42m, then
# 12 days down because on-failure never re-fired).
# RestartSteps makes RestartMaxDelaySec effective (without it systemd warns and
# ignores the cap): backoff 5s -> 60s over 4 steps.
Restart=always
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60

# Logging goes to journalctl --user -u jcodemunch-watcher
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
