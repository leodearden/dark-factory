[Unit]
Description=jCodeMunch watch-claude (auto-index worktrees)
After=network.target

[Service]
Type=simple
# PyPI name `jcodemunch-mcp` was quarantined (admin review #308, ~2026-05-30) →
# bare `uvx jcodemunch-mcp` 404s. Pinned to the git source until PyPI is restored.
# v1.108.27 is the latest-stable line (index-schema matches existing on-disk indexes);
# the v2.x git tags are an OLDER/divergent line (older index schema) despite the
# higher semver — do NOT pin 2.x. Revert to `--with "jcodemunch-mcp[watch]"` once
# `uvx jcodemunch-mcp` resolves from PyPI again.
ExecStart=__UV_PATH__x --python 3.12 --from "jcodemunch-mcp[watch] @ git+https://github.com/jgravelle/jcodemunch-mcp.git@v1.108.27" \
  jcodemunch-mcp watch-claude \
  --repos __REPO_ROOT__

# Restart policy: Restart=always, NOT on-failure. watch-claude is a daemon that
# should never stay down, but it exits 0 on more than just signals: its main loop
# is asyncio.wait(FIRST_COMPLETED) over the repos-poller/manifest-watcher tasks,
# so an exception that kills a management task is swallowed and the process
# shuts down "cleanly" (observed 2026-05-30: exit 0/SUCCESS after 1h42m, then
# 12 days down because on-failure never re-fired).
# RestartSteps makes RestartMaxDelaySec effective (without it systemd warns and
# ignores the cap): backoff 5s -> 60s over 4 steps.
Restart=always
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60

# Logging goes to journalctl --user -u jcodemunch-watcher
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
