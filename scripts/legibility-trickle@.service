[Unit]
Description=Legibility nightly trickle for %i (confusion-reduction PRD task epsilon)
Documentation=file:///home/leo/src/dark-factory/plans/confusion-reduction-prd.md

[Service]
Type=oneshot
# All generic legibility CODE lives in the dark-factory checkout (PRD §5);
# only the target project varies, via the %i instance name.
WorkingDirectory=/home/leo/src/dark-factory
# Belt-and-suspenders: nightly.py self-bootstraps scripts/ onto sys.path when
# run directly (mirrors sampling.py/census_trigger.py's `if __name__ ==
# "__main__"` guard), but PYTHONPATH is set explicitly too so `from legibility
# import ...` resolves even if that self-bootstrap ever changes.
Environment=PYTHONPATH=/home/leo/src/dark-factory/scripts
# Every legibility call spawns the BARE name `claude` through the shared
# runner (shared.cli_invoke, task 6042), resolved against this PATH, which the
# census grandchild inherits too. Pinned absolutely, in the orchestrator
# units' form, because the `systemd --user` manager's own PATH can lack
# ~/.local/bin: on 2026-08-18 it started at boot (linger) 84 minutes before
# the login that imports ~/.profile, and the Persistent=true catch-up run
# ENOENT'd 6/6 digests on reify and 38/38 on dark_factory in about a second.
Environment=PATH=/home/leo/.local/bin:/home/leo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The multi-account pool (task 5488): the CLAUDE_OAUTH_TOKEN_* vars that
# config/usage-accounts.yaml names. A token source, never a token pin -- the
# gate picks the account per invocation. Policy for this directive and the
# next: OPERATIONS.md §"Legibility trickle accounts (03:00)". Optional ("-"):
# a missing .env must not stop the unit starting -- build_pool loads it itself
# and turns an empty pool into a recorded deferral (task 5635).
EnvironmentFile=-/home/leo/src/dark-factory/.env
# Load-bearing: the CLI prefers an API key over the OAuth token, and the .env
# above defines one.
UnsetEnvironment=ANTHROPIC_API_KEY
ExecStart=/home/leo/.local/bin/uv run --no-sync --project shared python scripts/legibility/nightly.py run --project-id %i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=timers.target
