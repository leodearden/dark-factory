[Unit]
Description=Legibility nightly trickle for %i (confusion-reduction PRD task epsilon)
Documentation=file:///home/leo/src/dark-factory/plans/confusion-reduction-prd.md

[Service]
Type=oneshot
# All generic legibility CODE lives in the dark-factory checkout (PRD §5);
# only the target project varies, via the %i instance name.
WorkingDirectory=/home/leo/src/dark-factory
# Belt-and-suspenders: nightly.py self-bootstraps scripts/ onto sys.path when
# run directly (mirrors sampling.py/census_trigger.py's `if __name__ ==
# "__main__"` guard), but PYTHONPATH is set explicitly too so `from legibility
# import ...` resolves even if that self-bootstrap ever changes.
Environment=PYTHONPATH=/home/leo/src/dark-factory/scripts
# coder.py's _invoke_cli resolves the CLI as `claude_bin or
# os.environ.get('LEGIBILITY_CLAUDE_BIN') or 'claude'`, so without this pin the
# bare name is execvp-resolved against whatever PATH the `systemd --user`
# manager happens to hold. On 2026-08-18 that manager started at boot
# (08:58:30, linger) with NO ~/.local/bin on PATH -- the graphical login that
# imports ~/.profile came 84 minutes later -- and the timer's Persistent=true
# catch-up run fired into exactly that window, ENOENT'ing 6/6 selected digests
# on reify and 38/38 on dark_factory in about one second. Mirrors this unit's
# existing choice of an absolute /home/leo/.local/bin/uv in ExecStart. This
# ALSO covers the census grandchild: nightly.py launches census.py via
# `subprocess.run([...], check=False)` with no `env=` kwarg, so the child
# inherits this Environment.
Environment=LEGIBILITY_CLAUDE_BIN=/home/leo/.local/bin/claude
# The multi-account pool (task 5488). account_pool.build_pool resolves each
# entry of config/usage-accounts.yaml (max-b..max-h) to its
# CLAUDE_OAUTH_TOKEN_* value out of os.environ; resolve none of them and the
# gate falls back to ~/.claude/.credentials.json as an account literally named
# 'default' -- one login for the whole night, the failure this unit's
# 2026-09-14 stopgap drop-in was papering over.
# BELT AND BRACES, not the pool's only loader: build_pool's own load_dotenv
# reads this same file, and measurably resolves all seven accounts with no
# CLAUDE_OAUTH_TOKEN_* in the environment at all -- so deleting this line does
# not strand the gate. It is kept so the unit states the dependency it runs on
# instead of burying it in Python.
# EnvironmentFile rather than a token pin: WHICH account each invocation uses
# is the gate's decision, made per invocation, not this file's.
EnvironmentFile=/home/leo/src/dark-factory/.env
# The other half, and load-bearing rather than tidiness: the CLI prefers
# ANTHROPIC_API_KEY over CLAUDE_CODE_OAUTH_TOKEN, so one inherited from the
# `systemd --user` manager's environment would authenticate every invocation
# as the key's identity while the gate's failover still LOOKED like it worked.
# Stripped here for this process (the EnvironmentFile above DOES define the
# key, and UnsetEnvironment is applied last, so this removes it again), once
# more in-process by account_pool.build_pool -- whose own load_dotenv of that
# same .env would otherwise put it straight back, defeating this directive for
# every child that inherits rather than being handed an env -- and again by
# coder.child_env for each child spawned with an explicit env. One policy,
# three enforcement points, because no one of them covers the others' scope.
UnsetEnvironment=ANTHROPIC_API_KEY
ExecStart=/home/leo/.local/bin/uv run --frozen --project shared python scripts/legibility/nightly.py run --project-id %i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=timers.target
