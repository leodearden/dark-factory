# The After= below omits pytest-jobserver.service and reify-jobserver.service on
# purpose: stream-touch is a Cargo workspace whose verify lane runs plain
# `cargo test --workspace` / `cargo clippy` and never opts into either shared
# jobserver. If it ever does, add the jobserver unit to After= with it.

[Unit]
Description=Stream Touch Orchestrator (supervised)
After=network.target fused-memory.service orchestrator-stream-touch.socket
# Wants=, not Requires=: a Requires= turns a single fused-memory boot-race failure
# into a PERMANENT cancel of our start job. Wants= orders us after it but lets us
# proceed; the ExecStartPre below waits for port 8002 and Restart=on-failure
# self-heals if fused-memory is mid-restart.
Wants=fused-memory.service
Wants=orchestrator-stream-touch.socket
# Restart-rate guard — MUST live under [Unit] (silently ignored under [Service]).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# CWD must be dark-factory so `uv run --project orchestrator` resolves the
# orchestrator package (its pyproject lives only under that repo).
WorkingDirectory=/home/leo/src/dark-factory
# Gate startup on fused-memory's MCP port (8002) being live. Pairs with Wants=.
ExecStartPre=/home/leo/bin/wait-for-port.py --timeout 280 127.0.0.1:8002
# --no-sync: every project's orchestrator shares dark-factory's ONE root .venv, and
# without this flag a start installs into it (task 5553).
ExecStart=/home/leo/.local/bin/uv run --no-sync --project orchestrator orchestrator run --config /home/leo/src/stream-touch/dark-factory-orchestrator.yaml
# Replicate PATH so verify subprocesses find cargo and uv (a user service gets a minimal PATH).
Environment=PATH=/home/leo/.cargo/bin:/home/leo/.local/npm-global/bin:/home/leo/.local/bin:/home/leo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=LANG=en_US.UTF-8
# Own-unit self-identification (matches the other orchestrator units).
Environment=ORCH_UNIT=orchestrator-stream-touch.service

# RestartSteps makes RestartMaxDelaySec effective (without it systemd warns and
# ignores the cap): backoff 10s -> 60s over 4 steps.
Restart=on-failure
RestartSec=10
RestartSteps=4
RestartMaxDelaySec=60
# Async shutdown cancels in-flight tasks, reaps agents, releases the lock.
TimeoutStopSec=90
# Must exceed the 280s ExecStartPre budget so a slow fused-memory cold-start is
# covered by ONE start attempt rather than burning StartLimit.
TimeoutStartSec=300

StandardOutput=journal
StandardError=journal

# A deliberate stop also stops the socket; a restart or crash keeps it bound.
ExecStopPost=-/home/leo/src/dark-factory/scripts/stop-socket-unless-restarting.sh %n

[Install]
WantedBy=default.target
Also=orchestrator-stream-touch.socket
