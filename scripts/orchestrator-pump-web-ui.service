# Provenance (task 3641, transcribed 2026-08-05):
#   This template was transcribed FROM the running host unit at
#   /home/leo/.config/systemd/user/orchestrator-pump-web-ui.service, which has
#   been live and enabled since 2026-07-17 with no committed source. Drift
#   direction is therefore COMMITTED-FOLLOWS-INSTALLED for every line below —
#   with exactly ONE declared exception:
#
#     RestartSteps=4  is present here and ABSENT on the host.
#
#   It is a deliberate forward-fix, not drift to be reconciled away. Without it
#   systemd parses RestartMaxDelaySec=, logs "Service has RestartMaxDelaySec=
#   but no RestartSteps= setting. Ignoring.", and discards the cap — so the
#   10s->60s backoff this unit advertises is inert on the host right now and
#   every restart waits exactly 10s forever. All six sibling orchestrator
#   templates carry RestartSteps=4.
#
#   Propagation is committed->installed via scripts/setup-host.sh, which copies
#   this file over the host's copy. A FUTURE parity pass (task 3424; the script
#   scripts/check_orchestrator_unit_parity.py is NOT yet written — do not go
#   looking for it) must read this header and NOT "reconcile" the RestartSteps=4
#   line back out to match the host.
#
#   Divergence from the fleet, flagged so it does not read as an oversight:
#   the After= below is NARROWER than every sibling orchestrator unit's — it
#   omits pytest-jobserver.service (and reify-jobserver.service). That is
#   correct here, not drift to be widened. Those units seed FIFO token buckets
#   consumed by the `shared.pytest_jobserver` pytest plugin, which a project
#   opts into via `pytest_plugins` in its own conftest.py. pump-web-ui's verify
#   lane shells out to its own backend/.venv/bin/pytest, an isolated venv with
#   no dependency on dark-factory's `shared` package and no such opt-in, so it
#   never touches /tmp/pytest-jobserver and inherits no boot-race from starting
#   before the jobservers. If pump-web-ui ever adopts the shared plugin, add
#   pytest-jobserver.service to After= at the same time.

[Unit]
Description=Pump Web UI Orchestrator (supervised)
# Narrower than the sibling units on purpose — see the provenance header.
After=network.target fused-memory.service
# Wants=, not Requires=: a Requires= turns a single fused-memory boot-race failure
# into a PERMANENT cancel of our start job. Wants= orders us after it but lets us
# proceed; the ExecStartPre below waits for port 8002 and Restart=on-failure
# self-heals if fused-memory is mid-restart.
Wants=fused-memory.service
# Restart-rate guard — MUST live under [Unit] (silently ignored under [Service]).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
# CWD must be dark-factory so `uv run --project orchestrator` resolves the
# orchestrator package (its pyproject lives only under that repo).
WorkingDirectory=/home/leo/src/dark-factory
# Gate startup on fused-memory's MCP port (8002) being live. Pairs with Wants=.
ExecStartPre=/home/leo/bin/wait-for-port.py --timeout 280 127.0.0.1:8002
ExecStart=/home/leo/.local/bin/uv run --frozen --project orchestrator orchestrator run --config /home/leo/src/pump-web-ui/dark-factory-orchestrator.yaml
# Replicate PATH so verify subprocesses find node/npm/uv (a user service gets a
# minimal PATH). node/npm are in /usr/bin, uv in ~/.local/bin.
Environment=PATH=/home/leo/.local/npm-global/bin:/home/leo/.local/bin:/home/leo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=LANG=en_US.UTF-8
# Own-unit self-identification (matches the other orchestrator units).
Environment=ORCH_UNIT=orchestrator-pump-web-ui.service

# RestartSteps makes RestartMaxDelaySec effective (without it systemd warns and
# ignores the cap): backoff 10s -> 60s over 4 steps. See the provenance header —
# this line is the one deliberate committed->installed fix in this file.
Restart=on-failure
RestartSec=10
RestartSteps=4
RestartMaxDelaySec=60
# Async shutdown cancels in-flight tasks, reaps agents, releases the lock.
TimeoutStopSec=90
# Must exceed the 280s ExecStartPre budget so a slow fused-memory cold-start is
# covered by ONE start attempt rather than burning StartLimit.
TimeoutStartSec=300

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
