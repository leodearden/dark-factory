[Unit]
Description=Nightly canonical/topic stamping COVERAGE census + retro-stamp rehearsal (task 4006)
# The NORMATIVE definitions of every figure this job produces are the census
# script itself -- its coverage/cross-tab docstrings and the schema_version it
# stamps into the JSON -- and the PRD section that owns the obligation. Read
# those, not any paraphrase, before changing what is measured. The report is
# also the standing instrument for gate 3626's re-measurement recipe items 3
# and 4 (slug conformance over all topics, and over canonical records alone).
Documentation=file:///home/leo/src/dark-factory/fused-memory/scripts/census_memory_metadata.py
Documentation=file:///home/leo/src/dark-factory/docs/prds/memory-metadata-vocabulary.md
Documentation=file:///home/leo/src/dark-factory/OPERATIONS.md

[Service]
Type=oneshot
# All logic lives in the committed wrapper script -- the unit itself is a thin
# systemd shell around it (mirrors
# scripts/reclaim-orphaned-worktrees.service). The wrapper runs the census
# and then a DRY-RUN of 3201's retro stamp, in sequence, and always exits 0: a
# recurring `oneshot` that can fail enters systemd `failed` state and STAYS
# there, silently stopping the whole nightly job. The census exits 1 by design
# whenever coverage.complete is false, which is routine on a live corpus.
WorkingDirectory=/home/leo/src/dark-factory
# Persistent=true boot catch-up runs before the login session pushes the user
# PATH, so uv in ~/.local/bin is unfindable; see
# scripts/fused-memory-flag-marker-sweep.service for the observed status=127.
# The wrapper resolves uv itself via scripts/lib/resolve_uv.sh, which also
# covers a stale installed unit; this line is belt-and-braces for everything
# else it runs.
Environment=PATH=/home/leo/.cargo/bin:/home/leo/.local/npm-global/bin:/usr/local/cuda-12.6/bin:/home/leo/.local/bin:/home/leo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/home/leo/src/dark-factory/scripts/memory-metadata-coverage-census.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=timers.target
