[Unit]
Description=Nightly self-check of the per-test timeout anchors and family leg budgets against the verify archive (task 10940)
Documentation=file:///home/leo/src/dark-factory/scripts/timeout_headroom_selfcheck.py
Documentation=file:///home/leo/src/dark-factory/plans/pytest-per-test-timeout-measurement-2026-09-17.md
Documentation=file:///home/leo/src/dark-factory/OPERATIONS.md

[Service]
Type=oneshot
# All logic lives in the committed wrapper, which always exits 0: a recurring
# oneshot that fails stays failed and silently stops the timer. The check's
# stamp, data/timeout-headroom-selfcheck/state.json, carries its outcome instead.
WorkingDirectory=/home/leo/src/dark-factory
# The wrapper runs `uv`, which the user manager's minimal PATH does not reach
# on a boot catch-up run. The fleet's one spelling, copied verbatim from
# scripts/fused-memory-flag-marker-sweep.service.
Environment=PATH=/home/leo/.cargo/bin:/home/leo/.local/npm-global/bin:/usr/local/cuda-12.6/bin:/home/leo/.local/bin:/home/leo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/home/leo/src/dark-factory/scripts/timeout-headroom-selfcheck.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=timers.target
