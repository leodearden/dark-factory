[Unit]
Description=Nightly timer for the legibility trickle (%i)

[Timer]
# Nightly at 03:00 local time; Persistent=true catches up a missed night
# (laptop asleep/offline at 03:00) on next boot/login instead of silently
# skipping it. A small randomized delay avoids every project's timer firing
# at the exact same instant.
#
# WHAT Persistent=true DOES NOT BUY, recorded in task 4514 because the
# gap is invisible from here: it is ONE catch-up attempt per missed
# night, and that attempt takes the missed target_date (run_nightly
# defaults target_date to yesterday UTC). Until task 5678 a failed
# attempt lost the date for good, with no later run retrying it. That is
# how 2026-08-17's sightings were permanently lost: reify main jumps
# b79cecf53a (08-16) straight to 75ea893d3a (08-18) with no "sightings
# for 2026-08-17" commit in between.
#
# Since task 5678 an unfinished night (a non-zero exit, or a usage-cap
# DEFERRED night) leaves its target_date in the project's retry backlog,
# and the next night whose own pass finishes retries the oldest owed
# date as an extra pass. Bounds and the abandonment rule live in
# scripts/legibility/trickle_state.py::fold_retry_backlog. Still NOT
# covered: a night systemd never started at all -- one catch-up fires
# for several missed nights, so the dates in between are never attempted.
OnCalendar=*-*-* 03:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
