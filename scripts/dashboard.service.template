[Unit]
Description=Dark Factory Dashboard (monitoring UI)
Documentation=file://__REPO_ROOT__/dashboard/prd.md
After=network.target fused-memory.service

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
# Bounded shutdown drain. uvicorn hard-bounds the connection drain: it wraps
# _wait_tasks_to_complete() in asyncio.wait_for(timeout=8) (uvicorn/server.py) and then
# force-cancels whatever is still running, so the process reaches lifespan shutdown by
# ~T+8s -- comfortably inside TimeoutStopSec=15, leaving ~7s for lifespan shutdown,
# interpreter exit and the `uv run` parent's own teardown. Without this flag the drain
# was unbounded: a browser polling every few seconds never let its keep-alive connections
# idle out, so the drain never completed and every restart ended in
# "State 'stop-sigterm' timed out. Killing." -> SIGKILL -> a ~16s dead window.
#
# --timeout-keep-alive 6 is pinned ABOVE THE SLOWEST client poller. The browser runs TWO
# independent recurring HTTP pollers -- data.js's 3s data refresh (POLL_INTERVAL_MS) and
# tab_overview.jsx's 5s /api/load host-load poll (LOAD_POLL_INTERVAL_MS) -- and each holds
# its own keep-alive connection, reusing it at its own interval. So the bound must clear
# the SLOWEST of them, not merely the busiest: 6 is the smallest value above the 5s
# poller. Below a poller's own interval the server closes that socket in the gap between
# its polls, exposing the server-closes-while-client-writes race -- trading a shutdown bug
# for a request-failure bug. This is one second above uvicorn's 5s default, which sat
# exactly ON the /api/load boundary (5s keep-alive vs a 5s poll) and so did not clear it.
# Keep-alive is not being asked to bound the drain; --timeout-graceful-shutdown already
# does that. Pinning it makes the poll-interval/keep-alive relationship explicit and
# greppable instead of hiding behind an implicit default. Enforced by
# tests/scripts/test_dashboard_service_template.py::
# test_keep_alive_timeout_is_pinned_above_poll_interval, which derives this floor from
# every poller registered in CLIENT_POLLERS -- so adding a slower poller, or slowing an
# existing one, requires raising this value in BOTH unit files.
ExecStart=__UV_PATH__ run --project dashboard \
  python -m uvicorn dashboard.app:app \
  --host 127.0.0.1 --port 8080 \
  --timeout-graceful-shutdown 8 \
  --timeout-keep-alive 6

# Cost/burndown aggregation roots (comma-separated). Standalone default: this repo only — additional project roots are LOCAL settings, added to the installed unit, not committed here. Keep spaces out of the value; systemd treats unquoted spaces as assignment separators.
Environment=DASHBOARD_KNOWN_PROJECT_ROOTS=__REPO_ROOT__

# Data root for the dashboard's own databases (burndown, metrics, runs,
# escalations, memory-evals). Declared explicitly (task 3572) rather than left
# to the Path.cwd() fallback in dashboard/src/dashboard/config.py, which made
# the data root an undeclared SIDE EFFECT of WorkingDirectory= — correct only
# by coincidence, so an edit to that directive silently relocated every DB.
#
# This does NOT retire WorkingDirectory=: ExecStart's RELATIVE
# `--project dashboard` still resolves against the cwd systemd sets from it.
#
# KEEP THIS VALUE EQUAL TO WorkingDirectory=. Enforced by
# tests/scripts/test_dashboard_service_template.py::
# test_project_root_env_matches_working_directory_in_both_unit_files and, for
# the installed copy, by scripts/check_dashboard_unit_parity.py — see
# UnitSpec.env_matches_directive there for the full rationale.
Environment=DASHBOARD_PROJECT_ROOT=__REPO_ROOT__

# Restart policy: always restart on failure, back off up to 60s.
# RestartSteps is load-bearing here, not decorative. Without it systemd logs
# "Service has RestartMaxDelaySec= but no RestartSteps= setting. Ignoring." at
# unit load and discards the cap entirely, so the backoff this comment claims
# never happens and a crash-looping dashboard retries every 5s forever.
# With it: backoff 5s -> 60s over 4 steps.
#
# Requires systemd >= 254, which introduced BOTH directives. Below that they
# are unknown keys: systemd logs "Unknown key name ... ignoring." and runs with
# a flat 5s retry, so this stanza reads correct while doing nothing. That
# degradation is what tests/scripts/test_dashboard_service_template.py::
# test_systemd_analyze_verify_reports_no_ignored_directives catches, which is
# why it matches the warning case-insensitively.
Restart=on-failure
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=60

# A clean SIGTERM stop exits 143, not 0: `uv run` propagates its child's signal
# death as 128+15. Without this line systemd's default classification records
# every graceful stop as "Failed with result exit-code" (status=143) — observed
# 2026-07-30 22:23:53 BST on this unit after task 3306's bounded-drain change,
# with six keep-alive clients attached. Left alone it compounds: each routine
# restart plants a false failure until "failed" means nothing and a real crash
# reads exactly like a deploy.
#
# Numeric, not SIGTERM: `uv run` translates the signal into an exit code before
# systemd sees it, so the journal reports result=exit-code/status=143 and a
# signal-name entry would not match what systemd actually observes.
#
# The trade: with 143 classified as success, Restart=on-failure no longer
# re-fires on it. For the restarts that actually happen in practice this costs
# nothing — both programmatic paths (scripts/restart-dashboard.sh:21,
# scripts/dashboard-watchdog.py) issue `systemctl --user restart`, an explicit
# stop for which systemd never consults Restart= at all.
#
# The residual case is an out-of-band `kill -TERM`, and there this IS a real
# loss of supervision, not merely a relocation of it. Previously exit 143 was
# a failure, Restart=on-failure fired, and the dashboard was back in ~5s. Now
# the unit stops cleanly and stays inactive until something else notices. That
# something is dark-factory-dashboard-watchdog.timer, which is slower by an
# order of magnitude: it probes /api/health every 30s and requires FAIL_STREAK
# (=3) CONSECUTIVE failures before it restarts anything, so detection is ~90s,
# not 30s. And that coverage is CONTINGENT — the installed timer is not armed
# yet (task 3289), so until 3289 lands an out-of-band SIGTERM leaves the
# dashboard down with nothing watching it at all.
#
# Accepted deliberately: nothing in normal operation sends this unit an
# out-of-band SIGTERM, whereas every routine restart was planting a false
# failure. Trading a rare slow recovery for an everyday-correct failed state
# is the right side of that bet, but it is a bet, and 3289 is what settles it.
SuccessExitStatus=143

TimeoutStopSec=15

# Logging goes to journalctl --user -u dark-factory-dashboard
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
