# fused-memory environment template.
#
# Copy to `fused-memory/.env` and fill in. The fused-memory server calls
# load_dotenv() from its working directory (the systemd unit's
# WorkingDirectory), so this is the file the fused-memory.service unit reads.
# It mirrors the repo-root `.env` (see `.env.example` there for full
# commentary) — keep the two in sync, or symlink one to the other.
#
# Gitignored. Never commit real values.

# Required: embeddings + extraction LLM (fused-memory/config/config.yaml).
OPENAI_API_KEY=

# Recommended.
MEM0_TELEMETRY=false

# Optional: multi-account Claude failover pool used by the reconciliation
# harness (via usage_cap.accounts_file). Not needed for single-user setups.
# CLAUDE_OAUTH_TOKEN_A=

# Optional overrides (defaults shown).
# FALKORDB_URI=redis://localhost:6379
# QDRANT_URL=http://localhost:6333
# RECON_ESCALATION_PORT=8103
