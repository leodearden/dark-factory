{
  "rubric": "v2.2",
  "cell_rules": {
    "hidden_detail": "A restated write adds something a reader acting on its record would need (HOME, LOSS, no CONFLICT), and a sighting is only counted, never shown.",
    "hidden_conflict": "A restated write disputes its record (CONFLICT), and the dispute sits in a sighting a reader of the record never sees.",
    "digest_conflict": "An amended write disputes its record (CONFLICT), and a reader of the record meets the dispute only as an untagged 240-character digest.",
    "wrong_home": "An attached write is not about its record's claim (HOME=NO); a contest whose dispute is true is never a wrong home (ruling 5b).",
    "false_conflict": "A contested write does not dispute its record (CONFLICT=NO), so a reader is told a sound record is in doubt.",
    "duplicate_clutter": "A standalone write restates an earlier record and adds nothing a reader needs (HOME, no LOSS, no CONFLICT).",
    "orphaned_conflict": "A standalone write disputes an earlier record (CONFLICT) that carries no superseded-by mark for it, so a reader of that record never learns of it.",
    "attached_supersession": "A write declaring that it supersedes its record was attached under it; a supersession is a new standalone record plus a mark, never an attach (ruling 5c)."
  },
