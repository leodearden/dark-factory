#!/usr/bin/env bash
# dark-factory project-specific checks (called from pre-commit).
# Receives repo root as $1 and the current branch as $2.
#
# TWO TIERS, and the split is deliberate:
#
#   UNIVERSAL (every branch) -- the merge-lane ratchet audit and the
#     code-quality render check below. Each is scoped to what this commit
#     STAGES, so an ordinary commit costs one `git diff --cached` per check
#     and spawns nothing.
#   MAIN ONLY -- ruff, the three staged-file style checks, and the merge
#     gate's module checks and screen for what this commit stages
#     (plans/merge-lane-policy-prd.md D8). These cost seconds to minutes,
#     which is the wrong price to pay on every commit of every task branch.
#
# WHY THE RATCHET AUDIT IS UNIVERSAL. A ratchet raise is INTRODUCED by a
# commit on a task branch and reaches main by MERGE -- exactly like the
# .task/ contamination the neighbouring universal guard in hooks/pre-commit
# exists to stop. A CLEAN merge runs pre-merge-commit rather than pre-commit
# (a conflicted one finished with `git commit` does run pre-commit), and the
# merge worker advances main with `git update-ref`, which runs no commit
# hooks, so a main-only audit would never see the two raises that actually
# landed (0b04534c7b, 52d98220ad -- both merge commits). Catching a raise
# where it is introduced is the placement that bites first;
# hooks/reference-transaction audits the landing itself, for what a rebase
# replay or a clean merge carried past this one.
#
# $2 DEFAULTS TO main, not to a `rev-parse` of the working tree. Before the
# branch was passed down this script had no branch concept at all: invoked
# directly, it ran every check. Defaulting to main keeps a direct invocation
# running every check AND points the unspecified case at the STRICTEST set:
# an omitted argument must never be the reason a check quietly does not run
# (INV-11). tests/scripts/test_project_checks_merge_gate_parity.py pins the
# main-only tier through a real commit in a throwaway repo.
#
# FOR A REPO THAT COPIED hooks/, the honest claim is narrower than "stays
# valid": a branch-unaware project-checks stays CORRECT, and stops being
# CHEAP. This repo's pre-commit no longer exits early on a non-main branch,
# so an older copy paired with it runs its whole main-only tier -- a
# full-package ruff and up to three pyright sweeps, seconds each -- on every
# commit on every branch, and blocks those commits on lint that previously
# gated main alone. Take this file with that pre-commit.

ROOT="${1:?}"
BRANCH="${2:-main}"

# ── merge-lane ratchet audit (ALL BRANCHES, staged-scoped) ───────────
#
# scripts/merge_lane_metrics.py's write gate refuses to absorb a raise into
# a baseline it can READ first; what it cannot see is that baseline deleted
# before the write, or rendered elsewhere and copied over. The auditor below
# asks the other question -- does this COMMIT raise anything -- by comparing
# the staged baseline against HEAD's blob, or, finishing a conflicted merge,
# against what merging both parents may hold, so every route to a widened
# baseline lands in front of one comparison.
#
# NO `|| true` on this filter, unlike the grep-terminated ones below: an empty
# listing must mean "nothing staged", never "git could not answer". A corrupt
# or locked index would otherwise disarm the audit in silence -- the very shape
# this gate exists to close, reproduced one layer out (INV-11).
# The ledger is a DIRECTORY, one file per authorization; the retired
# single-array file stays listed because the commit that splits it, and any
# commit that stages it back, is the auditor's to judge.
ratchet_artifacts=(
    orchestrator/tests/merge_lane_ratchet_baseline.json
    orchestrator/tests/merge_lane_ratchet_raises
    orchestrator/tests/merge_lane_ratchet_authorized_raises.json
)
staged_ratchet="$(cd "$ROOT" && git diff --cached --name-only --diff-filter=ACMRD -- \
    "${ratchet_artifacts[@]}")" || {
    echo "pre-commit: could not list staged ratchet artifacts (git rc=$?);"
    echo "  refusing the commit rather than skipping the audit."
    exit 1
}
# FINISHING A MERGE, the listing runs against MERGE_HEAD too: a resolution
# that keeps HEAD's artifacts byte-for-byte while dropping MERGE_HEAD's moves
# or entries differs from MERGE_HEAD alone, and it is exactly the one that
# breaks a merge's invariant. Still PRECISE rather than "audit every merge":
# a merge that never touches the artifacts must spawn no python, or an
# environment that cannot import `shared` would refuse an unrelated merge.
if merge_head="$(cd "$ROOT" && git rev-parse -q --verify MERGE_HEAD)"; then
    staged_ratchet+="$(cd "$ROOT" && git diff --cached --name-only --diff-filter=ACMRD \
        "$merge_head" -- "${ratchet_artifacts[@]}")" || {
        echo "pre-commit: could not list ratchet artifacts staged against MERGE_HEAD (git rc=$?);"
        echo "  refusing the commit rather than skipping the audit."
        exit 1
    }
fi
if [ -n "$staged_ratchet" ]; then
    echo "pre-commit: merge-lane ratchet audit (staged)..."
    # Plain python3, matching the three staged-file checks below: no uv
    # env-resolution overhead. The auditor fails LOUDLY if it cannot import
    # the instrument; it never skips itself.
    (cd "$ROOT" && python3 scripts/check_staged_ratchet_raise.py)
    ratchet_rc=$?
    # NO DIAGNOSIS IS RESTATED HERE. The auditor has six refusal paths (an
    # unrecorded raise, a staged baseline deletion, a rewritten ledger history,
    # a retired ledger split wrongly or staged back, an unreadable artifact, an
    # unimportable instrument) and prints its own named cause plus the ONE copy
    # of RAISE_REMEDY for the paths that remedy fits. A fixed "--authorize-raise
    # it" line here was wrong for most of them and sent the committer hunting
    # the wrong thing. Only the exit ladder is read: 1 policy, 2 instrument.
    if [ "$ratchet_rc" -eq 2 ]; then
        echo "pre-commit: merge-lane ratchet audit could NOT RUN (rc=2); its named cause is above."
        exit 1
    elif [ "$ratchet_rc" -ne 0 ]; then
        echo "pre-commit: merge-lane ratchet audit REFUSED this commit (rc=$ratchet_rc); see above."
        exit 1
    fi
fi

# ── code-quality render check (ALL BRANCHES, staged-scoped) ──────────
#
# roles.py renders the packaged code-quality doc at import through
# code_quality.py::render, and a docs-only commit straight to main never meets
# the merge gate's test of it. So whenever this commit stages either file, the
# STAGED doc is rendered with the STAGED renderer. NO `|| true` on the filter,
# for the same reason as the ratchet filter above.
code_quality_inputs=(
    orchestrator/src/orchestrator/agents/code_quality.md
    orchestrator/src/orchestrator/agents/code_quality.py
)
staged_code_quality="$(cd "$ROOT" && git diff --cached --no-renames --name-only -- \
    "${code_quality_inputs[@]}")" || {
    echo "pre-commit: could not list staged code-quality inputs (git rc=$?);"
    echo "  refusing the commit rather than skipping the render check."
    exit 1
}
if [ -n "$staged_code_quality" ]; then
    echo "pre-commit: code-quality render check (staged)..."
    if ! (cd "$ROOT" && python3 scripts/check_staged_code_quality_render.py); then
        echo "pre-commit: code-quality render check REFUSED this commit; its named cause is above."
        exit 1
    fi
fi

# ── main-only checks from here down ──────────────────────────────────

if [ "$BRANCH" != "main" ]; then
    echo "pre-commit: all checks passed."
    exit 0
fi

echo "pre-commit: linting (main branch)..."

# Every path the merge gate lints, in the order of the `ruff check` leg of
# dark-factory-orchestrator.yaml::lint_command, non-member paths included.
# That leg is the source of truth: tests/scripts/test_hook_ruff_targets_drift.py
# fails when this list and the leg disagree, so widen both together.
RUFF_TARGETS=(shared escalation fused-memory orchestrator dashboard sampler cockpit client-feed conftest.py df_pytest_isolation.py skills)
# Every tests/ directory the merge gate's check_bare_magicmock_config.py tail leg
# scans, in the order of dark-factory-orchestrator.yaml::lint_command. That leg is
# the source of truth: tests/scripts/test_hook_magicmock_test_dirs_drift.py fails
# when this list and the leg disagree, so widen both together.
MAGICMOCK_TEST_DIRS=(shared/tests escalation/tests fused-memory/tests orchestrator/tests dashboard/tests sampler/tests cockpit/tests client-feed/tests)

RUFF_PATHS=()
for target in "${RUFF_TARGETS[@]}"; do
    [ -e "$ROOT/$target" ] && RUFF_PATHS+=("$ROOT/$target")
done

# ruff check (runs from repo root, every target at once)
if ! uv run ruff check --quiet "${RUFF_PATHS[@]}"; then
    echo "pre-commit: ruff check failed. Fix lint errors before committing to main."
    exit 1
fi

# asyncmock assertion-style check — STAGED test files only (no repo-wide ambush).
# The repo-wide enforcement now lives in the per-module verify lint_commands (which
# also run in merge-queue verify); this pre-commit gate is the last line for a direct
# human commit to main and is scoped to what the commit actually stages.
# Script is stdlib-only (ast/argparse/pathlib/sys) — invoked via plain python3 to skip uv env-resolution overhead.
echo "pre-commit: asyncmock assertion-style check (staged)..."
staged_am="$(cd "$ROOT" && git diff --cached --name-only --diff-filter=ACMR -- \
    fused-memory/tests \
    | grep -E '\.py$' || true)"
if [ -n "$staged_am" ]; then
    if ! (cd "$ROOT" && printf '%s\n' "$staged_am" | xargs python3 fused-memory/scripts/check_asyncmock_assertion_style.py); then
        echo "pre-commit: asyncmock style check failed. Use assert_not_awaited() instead of assert_not_called() on AsyncMocks."
        exit 1
    fi
fi

# bare-magicmock-config check — STAGED test files only (no repo-wide ambush).
# See the asyncmock note above: repo-wide enforcement is in the verify lint_commands;
# this gate only inspects the .py test files this commit stages, so it never blocks an
# unrelated commit with debt that commit did not introduce.
# Script is stdlib-only (ast/argparse/pathlib/re/sys) — invoked via plain python3 to skip uv env-resolution overhead.
echo "pre-commit: bare-magicmock-config check (staged)..."
staged_mm="$(cd "$ROOT" && git diff --cached --name-only --diff-filter=ACMR -- \
    "${MAGICMOCK_TEST_DIRS[@]}" \
    | grep -E '\.py$' || true)"
if [ -n "$staged_mm" ]; then
    if ! (cd "$ROOT" && printf '%s\n' "$staged_mm" | xargs python3 fused-memory/scripts/check_bare_magicmock_config.py); then
        echo "pre-commit: bare-magicmock-config check failed."
        echo "  Use the mock_orch_config fixture or MagicMock(spec_set=pydantic_spec(...)) instead of bare MagicMock()."
        echo "  See task 1339 (migration) for the canonical fix pattern."
        echo "  To suppress a specific site: add '# noqa: bare-magicmock — <reason>' on the preceding non-blank line."
        exit 1
    fi
fi

# module-local TestClient fixture check — STAGED dashboard test files only.
# See the notes above: repo-wide enforcement lives in dashboard's verify
# lint_command (which also runs in merge-queue verify); this gate only inspects
# the .py files under dashboard/tests that THIS commit stages, so it never
# blocks an unrelated commit with debt that commit did not introduce.
#
# Deliberately scoped to dashboard/tests: conftest.py there owns the shared
# module-scoped _client fixture, and a second TestClient in a fixture means a
# second app lifespan per module. Other packages' tests build TestClients for
# other apps and are none of this rule's business.
# Script is stdlib-only (ast/argparse/pathlib/re/sys) — invoked via plain python3 to skip uv env-resolution overhead.
echo "pre-commit: module-local TestClient fixture check (staged)..."
staged_tc="$(cd "$ROOT" && git diff --cached --name-only --diff-filter=ACMR -- \
    dashboard/tests \
    | grep -E '\.py$' || true)"
if [ -n "$staged_tc" ]; then
    if ! (cd "$ROOT" && printf '%s\n' "$staged_tc" | xargs python3 fused-memory/scripts/check_module_local_testclient.py); then
        echo "pre-commit: module-local TestClient fixture check failed."
        echo "  Request conftest.py's shared module-scoped '_client' fixture instead of building your own."
        echo "  See task 4485 (guard), task 3571 (the dedup this makes durable)."
        echo "  To suppress a specific site: add '# noqa: module-local-testclient — <reason>' on the preceding non-blank line."
        exit 1
    fi
fi

# ── merge-gate module checks and screen (main only) ──────────────────
#
# scripts/hook_module_checks.py lists the units the merge gate would run for
# what this commit stages -- module:<m>:lint / module:<m>:type with each
# module's registered command, and screen:<id> for scripts/merge_screen.yaml --
# and every listed unit runs here, in parallel, verbatim
# (plans/merge-lane-policy-prd.md D8). NO `|| true` on the staged listing, and
# a helper failure refuses rather than skips: an empty listing must mean
# "nothing to check", never "could not answer" (INV-11).
#
# At most GATE_SLOTS units run at once: a staged shared/ or escalation/ file
# lists every module's type check, on a host whose merge verifies already
# load it. Units are reported in listing order. An interrupt (INT, or TERM
# sent to this hook alone) stops every running unit's whole process tree;
# the unit logs go on any exit.
GATE_SLOTS=4
gate_start=$SECONDS
staged="$(cd "$ROOT" && git -c core.quotepath=false diff --cached --no-renames --name-only --diff-filter=ACMRD)" || {
    echo "pre-commit: could not list staged files (git rc=$?);"
    echo "  refusing the commit rather than skipping the merge-gate checks."
    exit 1
}
listing="$(printf '%s\n' "$staged" | (cd "$ROOT" && uv run --project shared python scripts/hook_module_checks.py))"
listing_rc=$?
if [ "$listing_rc" -ne 0 ]; then
    echo "pre-commit: scripts/hook_module_checks.py could NOT RUN (rc=$listing_rc); its named cause is above."
    exit 1
fi
if [ -z "$listing" ]; then
    echo "pre-commit: merge-gate checks skipped (no staged file maps to a module or the screen) in $((SECONDS - gate_start))s"
else
    gate_units=()
    gate_commands=()
    gate_logs=()
    gate_pids=()
    gate_collected=0
    gate_failed=false
    gate_process_tree() {
        local child
        echo "$1"
        for child in $(pgrep -P "$1"); do gate_process_tree "$child"; done
    }
    gate_stop_units() {
        local job tree=()
        for job in $(jobs -rp); do tree+=($(gate_process_tree "$job")); done
        [ "${#tree[@]}" -eq 0 ] || kill -TERM "${tree[@]}" 2>/dev/null
    }
    gate_collect_next() {
        local i=$gate_collected unit_rc=0
        gate_collected=$((gate_collected + 1))
        wait "${gate_pids[$i]}" || unit_rc=$?
        if [ "$unit_rc" -eq 0 ]; then
            echo "  ok ${gate_units[$i]}"
        else
            echo "pre-commit: ${gate_units[$i]} FAILED (rc=$unit_rc): ${gate_commands[$i]}"
            tail -n 60 "${gate_logs[$i]}"
            gate_failed=true
        fi
    }
    trap 'rm -f "${gate_logs[@]}"' EXIT
    trap 'gate_stop_units; exit 130' INT
    trap 'gate_stop_units; exit 143' TERM
    while IFS=$'\t' read -r unit command; do
        if [ "$((${#gate_pids[@]} - gate_collected))" -ge "$GATE_SLOTS" ]; then
            gate_collect_next
        fi
        log="$(mktemp)"
        echo "  running $unit: $command"
        (cd "$ROOT" && bash -c "$command") < /dev/null > "$log" 2>&1 &
        gate_pids+=("$!")
        gate_units+=("$unit")
        gate_commands+=("$command")
        gate_logs+=("$log")
    done <<< "$listing"
    while [ "$gate_collected" -lt "${#gate_pids[@]}" ]; do
        gate_collect_next
    done
    echo "pre-commit: merge-gate checks: ${#gate_units[@]} unit(s) in $((SECONDS - gate_start))s"
    if [ "$gate_failed" = true ]; then
        echo "pre-commit: commit REFUSED -- fix the unit(s) above (the merge gate runs the same commands)"
        exit 1
    fi
fi

echo "pre-commit: all checks passed."
