.env
.mcp.json

# ── Runtime data — SQLite DBs, escalation queue, burndown snapshots ──
# These are live state managed by fused-memory / orchestrator / dashboard.
# Tracked accidentally; removed from index in commit XXXX.
# Anchored at repo root so dashboard/src/dashboard/data/ (Python module) is
# not silently ignored.
/data/

# ── Worktrees — orchestrator task branches and eval runs ─────────────
# Git worktree directories contain .git files pointing to the main repo.
# Tracking them creates gitlink (160000) entries that conflict with
# checkout, stash, and merge operations.
.worktrees/
.worktrees-orphaned/
.eval-worktrees/
.claude/worktrees/

# ── Taskmaster — managed by fused-memory MCP ─────────────────────────
.taskmaster/

# ── .task/ — orchestrator scratch directory ──────────────────────────
# DO NOT REMOVE THIS LINE.
#
# .task/ is the per-worktree scratch directory used by the orchestrator
# during task execution (plan.json, iterations.jsonl, reviews/, etc.).
# It must NEVER be committed to main.  If it is, every future worktree
# branched from main inherits it, agents treat the stale state as real,
# and cross-task contamination cascades across all concurrent tasks.
#
# This .gitignore entry is ONE layer of defense.  Additional guards:
# - .task/.gitignore (contains "*")
# - git_ops.commit() uses :!.task pathspec + post-staging safety check
# - git_ops.merge_to_main() scrubs .task/ after merge
# - git_ops.advance_main() hard-gates on .task/ presence
# - hooks/pre-commit blocks .task/ from being committed to main
#
# If you are an AI agent: you may NOT remove this entry.  If you think
# .task/ needs to be committed to main, you are wrong.
.task/

__pycache__/
*.pyc

# ── Coverage artifacts — pytest-cov run products ─────────────────────
# .coverage is a SQLite DB rewritten by every `pytest --cov` run.  One was
# committed accidentally as shared/.coverage (task 3324).  Because the
# project_root checkout is machine-operated (merge worker, startup
# reconciler, git hooks all act on the working tree directly), a tracked
# copy shows up as a perpetually-modified binary after any local test run.
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Test SQLite artifacts — MagicMock path side-effects ──────────────
# OverrideStore creates an SQLite DB at config.overrides_db_path; when
# tests pass an unpatched MagicMock as config the stringified mock name
# becomes the path, producing files like "<MagicMock name='...' id='...'>".
<MagicMock*

# ── pytest scratch debris — `--basetemp` inside a checkout ───────────
# An agent passing `pytest --basetemp=.pytest-tmp` (legal and expected —
# see orchestrator/tests/test_warm_lane_scripts_shipped.py and
# _orch_helpers.py) drops scratch dirs inside the checkout. Those dirs
# can contain embedded git repos (e.g. a fixture's own `git init`), which
# breaks the mandated `git add -- .` staging command two ways: a
# commit-less embedded repo makes git exit 128 ("does not have a commit
# checked out" / "fatal: adding files failed"), aborting the whole
# staging operation; one that HAS a commit exits 0 but silently stages a
# 160000 gitlink that would then ride the task branch into the merge
# lane. Deliberately NOT anchored — unlike /data/ above — because the
# verify chain runs `cd <subproject> && uv run pytest`, so scratch also
# lands at e.g. orchestrator/.pytest-tmp/, not just at the repo root.
.pytest-tmp/
# Same debris class. Previously ignored only in fused-memory/.gitignore,
# leaving the other six subprojects exposed to the same staging
# pollution. `git ls-files` confirms nothing is tracked under any
# .pytest_cache, so promoting it here untracks nothing.
.pytest_cache/

# ── Runtime / debug artifacts ────────────────────────────────────────
# Transient output from verification screenshots, MCP tooling, log runs,
# and skill/watcher run-products.  None of this belongs in history.
# (gitignore has no inline comments — annotations are on their own lines.)
# Root-level debug/verification screenshots:
/*.png
# Playwright MCP console logs + screenshots:
.playwright-mcp/
# Stray empty marker file:
.codex
# Orchestrator / orchestrate run logs:
/logs/
# Runtime data (combine_audit.jsonl, etc.) — note /data/ above is root-only:
orchestrator/data/
# recon-escalation-watcher run manifests (mcp.json + run.sh stay tracked):
recon-watch/close-manifest*.json
# /review skill phase outputs (review/briefing.yaml stays tracked):
review/reports/
# Editor/tool temp-backup files (e.g. foo.py.tmp.<pid>.<hash>) — one was
# accidentally committed as test_merge_queue_concurrent_verify.py.tmp.* (task 1990):
*.tmp.*
# Same, scoped explicitly to Python source backups:
*.py.tmp.*

# ── Node / codex CLI install (ad-hoc, not a project dependency) ──────
node_modules/
