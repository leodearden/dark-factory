# Dark Factory environment template.
#
# Copy to `.env` (repo root) and fill in. The orchestrator CLI calls
# load_dotenv() from the repo root at startup, so this file is read by every
# `orchestrator run` / systemd orchestrator unit. The fused-memory server
# loads its own copy from `fused-memory/.env` (see fused-memory/.env.example)
# — keep the two files in sync, or symlink one to the other.
#
# Both `.env` files are gitignored. Never commit real values.

# --- Required ---------------------------------------------------------------

# Embeddings + extraction LLM for Graphiti/Mem0 (see fused-memory/config/config.yaml).
# This is the only key the core factory needs.
OPENAI_API_KEY=

# --- Recommended ------------------------------------------------------------

# Disable Mem0's telemetry phone-home.
MEM0_TELEMETRY=false

# --- Optional: multi-account Claude failover pool ---------------------------
#
# NOT needed for a single-user setup — with these unset, agents use the
# Claude Code CLI's own logged-in OAuth credentials. To run a failover pool,
# create one long-lived OAuth token per Claude subscription
# (`claude setup-token`), list the accounts in config/usage-accounts.yaml
# (each entry's `oauth_token_env` names one of these variables), and fill in
# the tokens here. See OPERATIONS.md ("Cost & capacity").

# CLAUDE_OAUTH_TOKEN_A=
# CLAUDE_OAUTH_TOKEN_B=
# CLAUDE_OAUTH_TOKEN_C=

# --- Optional: overrides (defaults shown; see fused-memory/config/config.yaml) ---

# FALKORDB_URI=redis://localhost:6379
# QDRANT_URL=http://localhost:6333
# RECON_ESCALATION_PORT=8103

# Where the dark-factory checkout lives (used to locate config/usage-accounts.yaml
# from other working directories; defaults to /home/leo/src/dark-factory — set it).
# DARK_FACTORY_ROOT=

# --- Optional: side tooling (NOT needed for the core factory) ---------------
# Used only by eval harnesses and auxiliary scripts.

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
# HF_DOWNLOAD_TOKEN=
# RUNPOD_API_KEY=
